{
  "name": "leaf-file-editor",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs desktop",
    "dev:web": "node scripts/dev.mjs web",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "node scripts/native.mjs build",
    "package:portable": "pnpm build:desktop && node scripts/package-portable.mjs",
    "package:portable:existing": "node scripts/package-portable.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:ports": "node --test tests/ports.test.mjs",
    "test:packaging": "node --test tests/windows-pe.test.mjs tests/licenses.test.mjs tests/build-record.test.mjs tests/native-files.test.mjs",
    "test:native": "node scripts/native.mjs test",
    "test:native:ui": "node scripts/test-native-ui.mjs",
    "test:native:profile": "node scripts/test-native-profile.mjs",
    "check:native": "node scripts/native.mjs check",
    "check": "vue-tsc --noEmit",
    "preview": "node scripts/dev.mjs preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "marked": "18.1.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.34.7"
